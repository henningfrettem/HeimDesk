# Your actual todo data and pasted images.
#
# This lives alongside the app rather than in it — the app writes todos.json
# into whatever folder you point it at. It is deliberately NOT committed:
# the repo is public, and these files contain your real notes.
#
# Back them up by copying the folder, or by putting it in OneDrive/Dropbox.
todos.json
assets/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
supabase-check.html

# Local Supabase connection details (see config.local.example.js)
config.local.js

# The hosted site, built by deploy/build.js
dist/

# Security audit approvals, reports and settings (see scripts/security/gate.mjs).
# Never committed: the repo is public, and a report is a map of weaknesses.
.security/

# Personal notes and checklists, which may name the live address.
*.local.md
